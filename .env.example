# NexaTalk Production & Local Environment Variables Template
# Copy this file to .env or backend/.env and populate with your actual secrets.

# ==========================================
# SERVER CONFIGURATION
# ==========================================
NODE_ENV=development
PORT=3000
API_BASE_URL=http://localhost:3000
APP_PUBLIC_URL=http://localhost:3000
CORS_ORIGIN=*

# ==========================================
# DATABASE & CACHING
# ==========================================
# PostgreSQL connection string
DATABASE_URL="postgresql://nexatalk:nexatalk_secret_password@localhost:5432/nexatalk_db?schema=public"

# Optional Redis connection string for distributed sessions & cache
REDIS_URL="redis://localhost:6379"

# ==========================================
# AUTHENTICATION & SECURITY (JWT)
# ==========================================
# High-entropy random secret strings for tokens
JWT_ACCESS_SECRET="nexatalk_super_secret_jwt_access_token_key_min_32_chars_2026"
JWT_REFRESH_SECRET="nexatalk_super_secret_jwt_refresh_token_key_min_32_chars_2026"
JWT_ACCESS_EXPIRY="15m"
JWT_REFRESH_EXPIRY="30d"

# ==========================================
# DEVELOPMENT / DEMO TOGGLES
# ==========================================
# Enable mock SMS/Email console output for local development without paid API keys
DEV_MOCK_SMS=true
DEV_MOCK_EMAIL=true
ENABLE_DEMO_LOGIN=true

# ==========================================
# SMS OTP PROVIDER (Twilio / AWS SNS / Generic)
# ==========================================
# Set to 'twilio', 'aws_sns', or 'generic'
SMS_PROVIDER=twilio
SMS_API_KEY=your_twilio_account_sid_here
SMS_API_SECRET=your_twilio_auth_token_here
SMS_FROM=+15550192834

# ==========================================
# TRANSACTIONAL EMAIL (Resend / SendGrid / SMTP)
# ==========================================
# Set to 'resend', 'sendgrid', or 'smtp'
EMAIL_PROVIDER=resend
EMAIL_API_KEY=re_your_resend_api_key_here
EMAIL_FROM=notifications@nexatalk.app

# ==========================================
# GOOGLE OAUTH
# ==========================================
GOOGLE_CLIENT_ID=your_google_client_id_here.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# ==========================================
# APPLE SIGN IN
# ==========================================
APPLE_TEAM_ID=your_apple_team_id_here
APPLE_CLIENT_ID=app.nexatalk.client
APPLE_KEY_ID=your_apple_key_id_here
APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ==========================================
# S3 / OBJECT STORAGE (AWS S3 / Cloudflare R2 / MinIO)
# ==========================================
# Set to 'local' for local uploads folder, or 's3' / 'minio'
STORAGE_PROVIDER=local
STORAGE_ENDPOINT=http://localhost:9000
STORAGE_BUCKET=nexatalk-media
STORAGE_ACCESS_KEY=minioadmin
STORAGE_SECRET_KEY=minioadminpassword
STORAGE_REGION=us-east-1

# ==========================================
# FIREBASE CLOUD MESSAGING (FCM Server Admin)
# ==========================================
FCM_PROJECT_ID=nexatalk-app
FCM_CLIENT_EMAIL=firebase-adminsdk@nexatalk-app.iam.gserviceaccount.com
FCM_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# ==========================================
# WEBRTC STUN / TURN AUDIO & VIDEO CALLING
# ==========================================
STUN_SERVER=stun:stun.l.google.com:19302
TURN_SERVER=turn:turn.nexatalk.app:3478
TURN_USERNAME=nexatalk_turn_user
TURN_PASSWORD=nexatalk_turn_password
